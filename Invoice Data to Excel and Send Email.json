    {
      "parameters": {
        "jsCode": "// Step 1: Get AI Agent output\nlet text = $input.first().json.output || \"\";\n\n// Step 2: Remove markdown code fences\ntext = text\n  .replace(/```json/gi, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\n// Step 3: Remove any unexpected non-JSON characters\ntext = text.replace(/[^\\x20-\\x7E\\r\\n]/g, \"\");\n\n// Step 4: Parse JSON\nlet parsed = {};\n\ntry {\n  parsed = JSON.parse(text);\n} catch (error) {\n  throw new Error(\"Invalid JSON returned by AI Agent:\\n\" + text);\n}\n\n// Step 5: Return individual fields\nreturn [\n  {\n    json: {\n      InvoiceNumber: parsed.InvoiceNumber || \"\",\n      InvoiceDate: parsed.InvoiceDate || \"\",\n      DueDate: parsed.DueDate || \"\",\n      PaymentStatus: parsed.PaymentStatus || \"\",\n      PaymentMethod: parsed.PaymentMethod || \"\",\n      Currency: parsed.Currency || \"\",\n      SubTotal: parsed.SubTotal || \"\",\n      TaxAmount: parsed.TaxAmount || \"\",\n      TotalAmount: parsed.TotalAmount || \"\",\n\n      FromCompanyName: parsed.From?.CompanyName || \"\",\n      FromAddress: parsed.From?.Address || \"\",\n      FromEmail: parsed.From?.Email || \"\",\n\n      BillToCompanyName: parsed.BillTo?.CompanyName || \"\",\n      BillToAddress: parsed.BillTo?.Address || \"\",\n      BillToEmail: parsed.BillTo?.Email || \"\"\n    }\n  }\n];"
      },
