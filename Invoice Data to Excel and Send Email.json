      "parameters": {
        "jsCode": "// Get all items (from Read/Write Files node)\nconst items = $input.all();\n\n// Filter items that actually have binary file data\nconst validFiles = items.filter(item => item.binary && Object.keys(item.binary).length > 0);\nconst fileCount = validFiles.length;\n\n// ✅ Case 1: Files found\nif (fileCount > 0) {\n  return validFiles.map(item => ({\n    json: {\n      ...item.json,\n      file_count: fileCount,\n      has_files: true,\n      message: `✅ Found ${fileCount} file(s) to process.`\n    },\n    binary: item.binary\n  }));\n}\n\n// ⚠️ Case 2: No files found\nreturn [\n  {\n    json: {\n      file_count: 0,\n      has_files: false,\n      message: `⚠️ Folder is empty — no files found for processing.`\n    }\n  }\n];\n"
      },
